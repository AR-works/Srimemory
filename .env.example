# Srinithi's Birthday Memory Web App - Environment Variables

# ----------------------------------------------------
# 1. Private PIN for S
# ----------------------------------------------------
# S's Secret PIN (default: 2024 for local testing)
S_PIN=2024

# Or provide a pre-hashed SHA-256 PIN with salt for production:
# S_PIN_HASH=your_sha256_hash_here
# S_PIN_SALT=s_bday_salt

# Secure Cookie Session Secret (random 32+ characters)
SESSION_SECRET=your_super_secret_session_key_for_s_bday_2024

# ----------------------------------------------------
# 2. Supabase Database Configuration
# ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ----------------------------------------------------
# 3. Google Drive Storage Configuration
# ----------------------------------------------------
# Target folder in Google Drive where files will be uploaded (Photos, Videos, PDFs, Other)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id

# Option A: Service Account (Recommended for server-to-server uploads)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: OAuth2 Client (Alternative)
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token
# GOOGLE_REDIRECT_URI=http://localhost:3000
