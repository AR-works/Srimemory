# Srinithi's Birthday Memory Web App - Environment Variables

# ----------------------------------------------------
# 1. Private PIN for Sri
# ----------------------------------------------------
# Sri's Secret PIN (default: 22082005)
S_PIN=22082005

# Or provide a pre-hashed SHA-256 PIN with salt for production:
# S_PIN_HASH=your_sha256_hash_here
# S_PIN_SALT=sri_bday_salt

# Secure Cookie Session Secret (random 32+ characters)
SESSION_SECRET=your_super_secret_session_key_for_sri_bday_2024

# ----------------------------------------------------
# 2. Supabase Database Configuration (Metadata Only)
# ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ----------------------------------------------------
# 3. Google Drive OAuth 2.0 Storage (100% Free - Developer's Account)
# ----------------------------------------------------
# Target folder ID in Google Drive (e.g. from drive.google.com/drive/folders/FOLDER_ID)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id

# OAuth 2.0 Client Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# OAuth 2.0 Refresh Token (generated automatically via /api/auth/google/login)
GOOGLE_REFRESH_TOKEN=your_oauth2_refresh_token_here
